/* 晶体分类/推荐卡片样式 */
.ccc-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.ccc-header {
  padding: 24rpx 28rpx 12rpx;
}

.ccc-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.ccc-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* === 分类列表 === */
.ccc-cat-list {
  padding: 0 16rpx;
}

.ccc-cat-item {
  display: flex;
  align-items: center;
  padding: 20rpx 12rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: #fafbfc;
  gap: 14rpx;
}

.ccc-cat-item-hover {
  background: #f0f2f5;
}

.ccc-cat-icon {
  font-size: 40rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f4ff;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.ccc-cat-info {
  flex: 1;
  min-width: 0;
}

.ccc-cat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.ccc-cat-count {
  font-size: 24rpx;
  color: #888;
  margin-top: 2rpx;
}

.ccc-cat-samples {
  display: flex;
  gap: 8rpx;
  margin-top: 6rpx;
  flex-wrap: wrap;
}

.ccc-cat-sample {
  font-size: 20rpx;
  color: #667eea;
  background: #eef2ff;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.ccc-cat-arrow {
  font-size: 24rpx;
  color: #ccc;
  flex-shrink: 0;
}

/* === 推荐列表 === */
.ccc-rec-list {
  padding: 0 16rpx;
}

.ccc-rec-item {
  display: flex;
  align-items: center;
  padding: 20rpx 12rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: linear-gradient(135deg, #fafbff, #faf5ff);
  gap: 12rpx;
}

.ccc-rec-item-hover {
  background: linear-gradient(135deg, #f0f2ff, #f0e8ff);
}

.ccc-rec-main {
  flex: 1;
  min-width: 0;
}

.ccc-rec-name {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.ccc-rec-formula {
  font-size: 24rpx;
  font-weight: 400;
  color: #888;
}

.ccc-rec-reason {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
  line-height: 1.4;
}

.ccc-rec-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.ccc-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.tag-system {
  background: #e8f4fd;
  color: #3b82f6;
}

.tag-category {
  background: #fef3c7;
  color: #b45309;
}

.ccc-rec-btn {
  padding: 14rpx 22rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.ccc-rec-btn-hover {
  opacity: 0.8;
}

/* === 空状态 === */
.ccc-empty {
  text-align: center;
  padding: 40rpx;
}

.ccc-empty-text {
  font-size: 26rpx;
  color: #999;
}

/* === 浏览全部入口 === */
.ccc-browse {
  padding: 18rpx 28rpx;
  text-align: center;
  border-top: 1rpx solid #f0f0f0;
}

.ccc-browse-text {
  font-size: 26rpx;
  color: #667eea;
}

.ccc-browse-hover {
  background: #fafbff;
}
