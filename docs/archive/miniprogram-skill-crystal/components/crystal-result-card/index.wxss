/* 晶体搜索结果卡片样式 */
.crc-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.crc-header {
  display: flex;
  align-items: baseline;
  padding: 24rpx 28rpx 16rpx;
  gap: 12rpx;
}

.crc-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.crc-sub {
  font-size: 24rpx;
  color: #999;
}

/* 列表 */
.crc-list {
  padding: 0 16rpx;
}

.crc-item {
  display: flex;
  align-items: center;
  padding: 20rpx 12rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: #fafbfc;
}

.crc-item-hover {
  background: #f0f2f5;
}

.crc-info {
  flex: 1;
  min-width: 0;
}

.crc-name {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.crc-formula {
  font-size: 24rpx;
  font-weight: 400;
  color: #888;
}

.crc-subtitle {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.crc-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.crc-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.tag-system {
  background: #e8f4fd;
  color: #3b82f6;
}

.tag-category {
  background: #fef3c7;
  color: #b45309;
}

/* 操作按钮 */
.crc-actions {
  display: flex;
  gap: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.crc-btn {
  padding: 12rpx 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.15s;
}

.crc-btn-primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}

.crc-btn-secondary {
  background: #f0f2f5;
  color: #555;
}

.crc-btn-hover {
  opacity: 0.8;
}

/* 空结果 */
.crc-empty {
  text-align: center;
  padding: 48rpx 28rpx;
}

.crc-empty-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.crc-empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 8rpx;
}

.crc-empty-sub {
  font-size: 24rpx;
  color: #999;
}

/* 查看全部入口 */
.crc-more {
  padding: 20rpx 28rpx;
  text-align: center;
  border-top: 1rpx solid #f0f0f0;
}

.crc-more-text {
  font-size: 26rpx;
  color: #667eea;
}

.crc-more-hover {
  background: #fafbff;
}
