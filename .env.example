# 复制为 .env 后填写；.env 已被 .gitignore 忽略。
# 后台统计服务至少需要 ANALYTICS_ADMIN_PASSWORD（8 位以上）。

ANALYTICS_ADMIN_USER=admin
ANALYTICS_ADMIN_PASSWORD=replace-with-a-long-password

# 建议固定一个随机串；不填则每次重启后管理员需重新登录。
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SESSION_SECRET=

# 数据目录（SQLite 单文件）
ANALYTICS_DATA_DIR=data/analytics

# 静态站点目录；不填默认 apps/web/dist。若由 Nginx 托管静态站点，这一项可忽略。
ANALYTICS_STATIC_DIR=apps/web/dist

# 只监听本机，由 Nginx 反代 /api 与 /admin；不要把 8787 直接暴露到公网。
HOST=127.0.0.1
PORT=8787

# 统计日界（东八区 = 480 分钟）
ANALYTICS_TZ_OFFSET_MINUTES=480
