{
  "pages": [
    {
      "path": "pages/index/index",
      "name": "晶体结构库首页",
      "description": "展示所有晶体结构卡片列表，支持按分类筛选（金属晶体、离子晶体、共价晶体、分子晶体、混合键型）。用户可点击卡片进入3D查看器。"
    },
    {
      "path": "pages/viewer/viewer",
      "name": "晶体3D查看器",
      "description": "以Three.js渲染晶体的三维结构，支持旋转/缩放/平移、切换CPK/球棍模型、控制原子/键/线框/空隙/对称元素等图层显示。点击原子可查看元素详情。",
      "query": {
        "type": "object",
        "properties": {
          "crystal": {
            "type": "string",
            "description": "晶体ID，如 naCl, fcc, bcc, hcp, diamond 等"
          }
        },
        "required": ["crystal"]
      }
    },
    {
      "path": "pages/compare/compare",
      "name": "晶体对比视图",
      "description": "并排对比两个晶体的3D结构，适合教学场景进行结构差异比较。",
      "query": {
        "type": "object",
        "properties": {
          "crystal1": {
            "type": "string",
            "description": "第一个晶体ID"
          },
          "crystal2": {
            "type": "string",
            "description": "第二个晶体ID"
          }
        },
        "required": ["crystal1", "crystal2"]
      }
    },
    {
      "path": "pages/settings/settings",
      "name": "设置页",
      "description": "应用设置页面。"
    }
  ]
}
