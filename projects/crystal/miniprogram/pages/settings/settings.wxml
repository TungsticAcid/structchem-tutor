<!-- 全局设置页面 -->
<navigation-bar title="全局设置" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="settings-page" scroll-y>
  <!-- 视觉颜色设置 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">视觉颜色</text>
      <view class="reset-all-btn" bindtap="onResetAllVisualColors">
        <text class="reset-text">恢复默认</text>
      </view>
    </view>
    <text class="section-desc">自定义3D视图中的背景、线框、空隙等颜色</text>
    <view class="visual-color-list">
      <view class="visual-color-row"
        wx:for="{{visualColors}}" wx:key="key"
        data-key="{{item.key}}" data-label="{{item.label}}"
        bindtap="onVisualColorTap">
        <text class="visual-color-label">{{item.label}}</text>
        <view class="visual-color-right">
          <view class="visual-color-swatch" style="background-color: {{item.color}}"></view>
          <text class="visual-color-hex">{{item.color}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 元素颜色设置 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">元素颜色</text>
      <view class="header-actions">
        <view class="view-toggle" bindtap="onToggleView">
          <text>{{viewMode === 'grid' ? '周期表' : '列表'}}</text>
        </view>
        <view class="reset-all-btn" bindtap="onResetAll">
          <text class="reset-text">恢复默认</text>
        </view>
      </view>
    </view>
    <text class="section-desc">点击元素可自定义其在3D视图中的显示颜色</text>

    <!-- 网格视图 -->
    <view class="color-grid" wx:if="{{viewMode === 'grid'}}">
      <view class="color-item {{item.hasOverride ? 'has-override' : ''}}"
        wx:for="{{elements}}" wx:key="symbol"
        data-symbol="{{item.symbol}}"
        bindtap="onElementTap">
        <view class="color-swatch" style="background-color: {{item.currentColor}}">
          <text class="color-symbol" style="color: {{item.currentColor === '#ffffff' || item.currentColor === '#cccccc' ? '#333' : '#fff'}}">{{item.symbol}}</text>
        </view>
        <text class="color-name">{{item.name}}</text>
      </view>
    </view>

    <!-- 周期表视图 -->
    <scroll-view class="pt-scroll" scroll-x wx:if="{{viewMode === 'periodicTable'}}">
      <view class="pt-container">
        <!-- 族标签行 -->
        <view class="pt-row pt-group-labels">
          <view class="pt-cell-empty" wx:for="{{ptGroupLabels}}" wx:key="colIdx" wx:for-index="colIdx">
            <text class="pt-group-label" wx:if="{{item}}">{{item}}</text>
          </view>
        </view>
        <!-- 周期表主体（行1-7主表 + 行8-9镧锕系） -->
        <view class="pt-row {{rowIdx === 7 ? 'pt-fblock-sep' : ''}}" wx:for="{{ptGrid}}" wx:key="*this" wx:for-index="rowIdx">
          <view
            wx:for="{{item}}" wx:key="colIdx" wx:for-item="cell" wx:for-index="colIdx"
            data-symbol="{{cell ? cell.symbol : ''}}"
            bindtap="{{cell ? 'onElementTap' : ''}}"
            class="pt-cell {{cell ? 'pt-has-element' : 'pt-empty'}} {{cell && cell.hasOverride ? 'pt-has-override' : ''}}"
          >
            <block wx:if="{{cell}}">
              <view class="pt-cell-bg" style="background-color: {{cell.currentColor}}"></view>
              <text class="pt-cell-symbol" style="color: {{cell.currentColor === '#ffffff' || cell.currentColor === '#cccccc' || cell.currentColor === '#fff' ? '#333' : '#fff'}}">{{cell.symbol}}</text>
            </block>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</scroll-view>

<!-- 颜色选择器弹窗 -->
<view class="picker-overlay" wx:if="{{pickerVisible}}" bindtap="onPickerClose">
  <view class="picker-dialog" catchtap="preventTap">
    <text class="picker-title" wx:if="{{pickerElement}}">选择 {{pickerElement}} 的颜色</text>
    <text class="picker-title" wx:elif="{{pickerVisualKey}}">选择{{pickerVisualLabel}}颜色</text>

    <!-- 预设颜色 -->
    <view class="preset-colors">
      <view class="preset-swatch"
        wx:for="{{presetColors}}" wx:key="*this"
        data-color="{{item}}"
        style="background-color: {{item}}"
        bindtap="onPresetColorTap">
      </view>
    </view>

    <!-- 自定义颜色 -->
    <view class="custom-color-row">
      <text class="custom-label">自定义</text>
      <input class="custom-input" type="text" maxlength="7"
        value="{{customColor}}" bindinput="onCustomColorInput"
        placeholder="#RRGGBB" />
      <view class="custom-apply-btn" bindtap="onCustomColorApply">
        <text>确定</text>
      </view>
    </view>

    <!-- 重置 -->
    <view class="picker-reset" wx:if="{{pickerElement}}" bindtap="onResetElement" data-symbol="{{pickerElement}}">
      <text>重置为默认颜色</text>
    </view>
    <view class="picker-reset" wx:elif="{{pickerVisualKey}}" bindtap="onResetVisualColor">
      <text>重置为默认颜色</text>
    </view>

    <view class="picker-close" bindtap="onPickerClose">
      <text>取消</text>
    </view>
  </view>
</view>
