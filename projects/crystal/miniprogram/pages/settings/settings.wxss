/** 全局设置页面样式 */
.settings-page {
  padding: 20rpx 32rpx;
  background: #f5f5f5;
  min-height: 100vh;
  overflow-x: hidden;
  box-sizing: border-box;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
  display: block;
}

.reset-all-btn {
  padding: 8rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.reset-text {
  font-size: 24rpx;
  color: #EA4335;
}

/* 颜色网格 */
.color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.color-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  padding: 12rpx 8rpx;
  border-radius: 12rpx;
  background: #fafafa;
  transition: background 0.15s;
  box-sizing: border-box;
}

.color-item:active {
  background: #e8e8e8;
}

.color-item.has-override {
  background: #e3f2fd;
  border: 2rpx solid #4285F4;
}

.color-swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(0,0,0,0.12);
  margin-bottom: 6rpx;
}

.color-symbol {
  font-size: 20rpx;
  font-weight: 600;
}

.color-name {
  font-size: 20rpx;
  color: #666;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

/* 颜色选择器弹窗 */
.picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.picker-dialog {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 600rpx;
  max-height: 80vh;
  box-sizing: border-box;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  text-align: center;
  margin-bottom: 28rpx;
}

/* 预设颜色 */
.preset-colors {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  margin-bottom: 28rpx;
}

.preset-swatch {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(0,0,0,0.12);
  transition: transform 0.1s;
}

.preset-swatch:active {
  transform: scale(1.15);
  border-color: #4285F4;
}

/* 自定义颜色 */
.custom-color-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.custom-label {
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.custom-input {
  flex: 1;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: #333;
}

.custom-apply-btn {
  padding: 12rpx 24rpx;
  background: #4285F4;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.custom-apply-btn text {
  font-size: 24rpx;
  color: #fff;
}

/* 重置/取消 */
.picker-reset {
  text-align: center;
  padding: 16rpx;
  margin-bottom: 8rpx;
}

.picker-reset text {
  font-size: 26rpx;
  color: #EA4335;
}

.picker-close {
  text-align: center;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.picker-close text {
  font-size: 26rpx;
  color: #666;
}

/* 视图切换按钮 */
.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 视觉颜色列表 */
.visual-color-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.visual-color-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 12rpx;
  border-radius: 12rpx;
  background: #fafafa;
  transition: background 0.15s;
  box-sizing: border-box;
}

.visual-color-row:active {
  background: #e8e8e8;
}

.visual-color-label {
  font-size: 28rpx;
  color: #333;
}

.visual-color-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.visual-color-swatch {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0,0,0,0.12);
}

.visual-color-hex {
  font-size: 24rpx;
  color: #999;
  font-family: monospace;
}

.view-toggle {
  padding: 8rpx 20rpx;
  background: #4285F4;
  border-radius: 8rpx;
}

.view-toggle text {
  font-size: 24rpx;
  color: #fff;
}

/* ==================== 周期表视图 ==================== */
.pt-scroll {
  width: 100%;
  overflow-x: auto;
}

.pt-container {
  display: inline-flex;
  flex-direction: column;
  gap: 3rpx;
  min-width: 900rpx;
  padding-bottom: 24rpx;
}

/* 族标签行 */
.pt-group-labels {
  margin-bottom: 4rpx;
}

.pt-cell-empty {
  width: 48rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pt-group-label {
  font-size: 18rpx;
  color: #999;
}

/* 周期表行 */
.pt-row {
  display: flex;
  gap: 3rpx;
}

.pt-fblock-sep {
  margin-top: 12rpx;
}

/* 周期表单元格 — 默认隐藏（空位） */
.pt-cell {
  width: 48rpx;
  height: 48rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.pt-empty {
  visibility: hidden;
}

/* 有元素的单元格 */
.pt-has-element {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform 0.1s;
  overflow: hidden;
}

.pt-has-element:active {
  transform: scale(1.3);
  z-index: 10;
}

.pt-has-override {
  border: 3rpx solid #4285F4;
  box-shadow: 0 0 4rpx rgba(66,133,244,0.5);
}

.pt-cell-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 4rpx;
}

.pt-cell-symbol {
  position: relative;
  z-index: 1;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1;
}
