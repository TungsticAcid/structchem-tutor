<!-- 晶体结构对比页面 - 双画布，支持横竖屏切换和独立样式控制 -->
<view class="compare-page">
  <!-- 顶部标题栏 -->
  <view class="top-bar">
    <view class="back-btn" bindtap="onBack">
      <text class="back-icon">←</text>
    </view>
    <text class="crystal-title">{{crystalName}} - 结构对比</text>
  </view>

  <!-- 双画布容器 -->
  <view class="dual-canvas-container layout-{{layoutMode}}">
    <!-- 左侧画布 -->
    <view class="canvas-pane">
      <viewer-canvas
        id="compareLeft"
        canvasId="compareCanvasLeft"
        crystalId="{{crystalId}}"
        modelType="{{leftModelType}}"
        stickRadius="{{leftStickRadius}}"
        showAtoms="{{leftShowAtoms}}"
        showWireframe="{{true}}"
        showInterstices="{{leftShowInterstices}}"
        showOctahedral="{{leftShowOctahedral}}"
        showTetrahedral="{{leftShowTetrahedral}}"
        showSymmetry="{{leftShowSymmetry}}"
        showBonds="{{leftShowBonds}}"
        showHydrogenBonds="{{leftShowHydrogenBonds}}"
        showAxes="{{leftShowAxes}}"
        showAuxiliaryBody="{{leftShowAuxiliaryBody}}"
        showAuxiliaryFace="{{leftShowAuxiliaryFace}}"
        auxiliaryLineAboveAtoms="{{auxiliaryLineAboveAtoms}}"
        atomScale="{{leftAtomScale}}"
        cellDisplayMode="{{leftCellDisplayMode}}"
        opacity="{{leftOpacity}}"
        depthFog="{{depthFog}}"
        fractionalShift="{{leftFractionalShift}}"
        partialAtoms="{{partialAtoms}}"
        projection="orthographic"
        lightConfig="{{lightConfig}}"
        atomVisibility="{{leftAtomVisibility}}"
        showAtomLabels="{{leftShowAtomLabels}}"
        showLatticePoints="{{leftShowLatticePoints}}"
        bind:viewstatechange="onViewStateChange"
        bind:resetview="onResetView"
        bind:atomTap="onAtomTap"
        bind:loaded="onCanvasLoaded"
      />
      <view class="pane-label pane-label-left">
        <text class="label-text">{{leftModelType === 'cpk' ? 'CPK空间填充' : '球棍模型'}}</text>
      </view>
    </view>

    <!-- 分隔线 -->
    <view class="canvas-divider divider-{{layoutMode}}"></view>

    <!-- 右侧画布 -->
    <view class="canvas-pane">
      <viewer-canvas
        id="compareRight"
        canvasId="compareCanvasRight"
        crystalId="{{crystalId}}"
        modelType="{{rightModelType}}"
        stickRadius="{{rightStickRadius}}"
        showAtoms="{{rightShowAtoms}}"
        showWireframe="{{true}}"
        showInterstices="{{rightShowInterstices}}"
        showOctahedral="{{rightShowOctahedral}}"
        showTetrahedral="{{rightShowTetrahedral}}"
        showSymmetry="{{rightShowSymmetry}}"
        showBonds="{{rightShowBonds}}"
        showHydrogenBonds="{{rightShowHydrogenBonds}}"
        showAxes="{{rightShowAxes}}"
        showAuxiliaryBody="{{rightShowAuxiliaryBody}}"
        showAuxiliaryFace="{{rightShowAuxiliaryFace}}"
        auxiliaryLineAboveAtoms="{{auxiliaryLineAboveAtoms}}"
        atomScale="{{rightAtomScale}}"
        cellDisplayMode="{{rightCellDisplayMode}}"
        opacity="{{rightOpacity}}"
        depthFog="{{depthFog}}"
        fractionalShift="{{rightFractionalShift}}"
        partialAtoms="{{partialAtoms}}"
        projection="orthographic"
        lightConfig="{{lightConfig}}"
        atomVisibility="{{rightAtomVisibility}}"
        showAtomLabels="{{rightShowAtomLabels}}"
        showLatticePoints="{{rightShowLatticePoints}}"
        bind:viewstatechange="onViewStateChange"
        bind:resetview="onResetView"
        bind:atomTap="onAtomTap"
        bind:loaded="onCanvasLoaded"
      />
      <view class="pane-label pane-label-right">
        <text class="label-text">{{rightModelType === 'cpk' ? 'CPK空间填充' : '球棍模型'}}</text>
      </view>
    </view>
  </view>

  <!-- 底部浮动控制条 -->
  <view class="compare-control-bar">
    <!-- 联动控制 -->
    <view class="sync-group">
      <view class="control-btn layout-toggle-btn" bindtap="onToggleLayout">
        <text class="control-icon">{{layoutMode === 'horizontal' ? '☰' : '▮'}}</text>
        <text class="control-text">{{layoutMode === 'horizontal' ? '竖屏' : '横屏'}}</text>
      </view>
      <view class="control-btn sync-btn {{syncMode ? 'active' : ''}}" bindtap="onToggleSync">
        <text class="control-icon">{{syncMode ? '🔗' : '🔓'}}</text>
        <text class="control-text">{{syncMode ? '联动' : '独立'}}</text>
      </view>
      <view class="control-btn align-btn" bindtap="onAlignViews">
        <text class="control-icon">↺</text>
        <text class="control-text">对齐视角</text>
      </view>
      <view class="control-btn align-btn" bindtap="onAlignStyle">
        <text class="control-icon">≡</text>
        <text class="control-text">对齐样式</text>
      </view>
    </view>

    <!-- 展开设置 -->
    <view class="control-btn settings-toggle-btn {{settingsExpanded ? 'active' : ''}}" bindtap="onToggleSettings">
      <text class="control-icon">⚙</text>
      <text class="control-text">{{settingsExpanded ? '收起' : '设置'}}</text>
    </view>
  </view>

  <!-- 可展开的设置面板 -->
  <view class="settings-panel {{settingsExpanded ? 'expanded' : ''}}">
    <scroll-view scroll-y class="settings-scroll" enhanced show-scrollbar="{{false}}">
      <!-- 共享设置 -->
      <view class="shared-projection-row" wx:if="{{isOrthogonalCell}}">
        <text class="shared-setting-label">共享设置（两侧同步）</text>
        <view class="mini-toggles" style="display: flex; align-items: center; gap: 8rpx;">
          <view class="mini-toggle {{partialAtoms ? 'on' : ''}}" bindtap="onPartialAtomsToggle">裁剪</view>
        </view>
      </view>

      <view class="settings-columns">
        <!-- 左/上侧设置列 -->
        <view class="settings-column">
          <view class="settings-col-header">
            <view class="col-dot" style="background:#4285F4;"></view>
            <text class="col-title">{{layoutMode === 'horizontal' ? '左侧设置' : '上侧设置'}}</text>
          </view>

          <!-- 模型类型 -->
          <view class="setting-section">
            <text class="setting-section-title">显示模型</text>
            <view class="mini-selector">
              <view class="mini-option {{leftModelType === 'ballStick' ? 'active' : ''}}" data-type="ballStick" bindtap="onLeftModelChange">球棍</view>
              <view class="mini-option {{leftModelType === 'cpk' ? 'active' : ''}}" data-type="cpk" bindtap="onLeftModelChange">CPK</view>
            </view>
          </view>

          <!-- 晶胞原点变换 -->
          <view class="setting-section" wx:if="{{equivalentSettings.length > 0}}">
            <text class="setting-section-title">变换晶胞原点</text>
            <view class="mini-selector">
              <view
                class="mini-option {{leftEquivalentIndex === idx ? 'active' : ''}}"
                wx:for="{{equivalentSettings}}" wx:key="label" wx:for-index="idx"
                data-index="{{idx}}"
                bindtap="onLeftEquivalentSettingChange"
              >{{item.label}}</view>
            </view>
          </view>

          <!-- 分元素显隐（仅在原子图层开启时显示） -->
          <view class="setting-section" wx:if="{{leftShowAtoms && crystalData.atoms}}">
            <text class="setting-section-title">元素筛选</text>
            <view class="mini-toggles">
              <view
                class="mini-toggle {{leftAtomVisibility[atomGroup.element] !== false ? 'on' : ''}}"
                wx:for="{{crystalData.atoms}}" wx:key="element" wx:for-item="atomGroup"
                data-element="{{atomGroup.element}}"
                bindtap="onLeftElementToggle"
              >{{atomGroup.element}}</view>
            </view>
          </view>

          <!-- 图层开关 -->
          <view class="setting-section">
            <text class="setting-section-title">图层</text>
            <view class="mini-toggles">
              <view class="mini-toggle {{leftShowAtoms ? 'on' : ''}}" data-layer="Atoms" bindtap="onLeftToggle">原子</view>
              <view class="mini-toggle {{leftShowAtomLabels ? 'on' : ''}}" data-layer="AtomLabels" bindtap="onLeftToggle">标签</view>
              <view class="mini-toggle {{leftShowBonds ? 'on' : ''}}" data-layer="Bonds" bindtap="onLeftToggle" wx:if="{{!isMolecularCrystal}}">键</view>
              <view class="mini-toggle {{leftShowHydrogenBonds ? 'on' : ''}}" data-layer="HydrogenBonds" bindtap="onLeftToggle" wx:if="{{hasHydrogenBonds}}">氢键</view>
              <view class="mini-toggle {{leftShowAxes ? 'on' : ''}}" data-layer="Axes" bindtap="onLeftToggle">轴</view>
              <view class="mini-toggle {{leftShowInterstices ? 'on' : ''}}" data-layer="Interstices" bindtap="onLeftToggle" wx:if="{{false}}">空隙</view>
              <view class="mini-toggle {{leftShowOctahedral ? 'on' : ''}}" data-layer="Octahedral" bindtap="onLeftToggle" wx:if="{{showIntersticeControl}}">八面体空隙</view>
              <view class="mini-toggle {{leftShowTetrahedral ? 'on' : ''}}" data-layer="Tetrahedral" bindtap="onLeftToggle" wx:if="{{showIntersticeControl}}">四面体空隙</view>
              <view class="mini-toggle {{leftShowAuxiliaryBody ? 'on' : ''}}" data-layer="AuxiliaryBody" bindtap="onLeftToggle">体对角</view>
              <view class="mini-toggle {{leftShowAuxiliaryFace ? 'on' : ''}}" data-layer="AuxiliaryFace" bindtap="onLeftToggle">面对角</view>
              <view class="mini-toggle {{leftShowLatticePoints ? 'on' : ''}}" data-layer="LatticePoints" bindtap="onLeftToggle">点阵型式</view>
            </view>
          </view>

          <!-- 晶胞模式：暂时隐藏 -->
          <view class="setting-section" wx:if="{{false}}">
            <text class="setting-section-title">晶胞</text>
            <view class="mini-selector">
              <view class="mini-option {{leftCellDisplayMode === 'conventional' ? 'active' : ''}}" data-mode="conventional" bindtap="onLeftCellDisplayModeTap">惯用</view>
              <view class="mini-option {{leftCellDisplayMode === 'primitive' ? 'active' : ''}}" data-mode="primitive" bindtap="onLeftCellDisplayModeTap">素胞</view>
            </view>
          </view>

        </view>

        <!-- 分隔 -->
        <view class="settings-col-divider"></view>

        <!-- 右/下侧设置列 -->
        <view class="settings-column">
          <view class="settings-col-header">
            <view class="col-dot" style="background:#EA4335;"></view>
            <text class="col-title">{{layoutMode === 'horizontal' ? '右侧设置' : '下侧设置'}}</text>
          </view>

          <!-- 模型类型 -->
          <view class="setting-section">
            <text class="setting-section-title">显示模型</text>
            <view class="mini-selector">
              <view class="mini-option {{rightModelType === 'ballStick' ? 'active' : ''}}" data-type="ballStick" bindtap="onRightModelChange">球棍</view>
              <view class="mini-option {{rightModelType === 'cpk' ? 'active' : ''}}" data-type="cpk" bindtap="onRightModelChange">CPK</view>
            </view>
          </view>

          <!-- 晶胞原点变换 -->
          <view class="setting-section" wx:if="{{equivalentSettings.length > 0}}">
            <text class="setting-section-title">变换晶胞原点</text>
            <view class="mini-selector">
              <view
                class="mini-option {{rightEquivalentIndex === idx ? 'active' : ''}}"
                wx:for="{{equivalentSettings}}" wx:key="label" wx:for-index="idx"
                data-index="{{idx}}"
                bindtap="onRightEquivalentSettingChange"
              >{{item.label}}</view>
            </view>
          </view>

          <!-- 分元素显隐 -->
          <view class="setting-section" wx:if="{{rightShowAtoms && crystalData.atoms}}">
            <text class="setting-section-title">元素筛选</text>
            <view class="mini-toggles">
              <view
                class="mini-toggle {{rightAtomVisibility[atomGroup.element] !== false ? 'on' : ''}}"
                wx:for="{{crystalData.atoms}}" wx:key="element" wx:for-item="atomGroup"
                data-element="{{atomGroup.element}}"
                bindtap="onRightElementToggle"
              >{{atomGroup.element}}</view>
            </view>
          </view>

          <!-- 图层开关 -->
          <view class="setting-section">
            <text class="setting-section-title">图层</text>
            <view class="mini-toggles">
              <view class="mini-toggle {{rightShowAtoms ? 'on' : ''}}" data-layer="Atoms" bindtap="onRightToggle">原子</view>
              <view class="mini-toggle {{rightShowAtomLabels ? 'on' : ''}}" data-layer="AtomLabels" bindtap="onRightToggle">标签</view>
              <view class="mini-toggle {{rightShowBonds ? 'on' : ''}}" data-layer="Bonds" bindtap="onRightToggle" wx:if="{{!isMolecularCrystal}}">键</view>
              <view class="mini-toggle {{rightShowHydrogenBonds ? 'on' : ''}}" data-layer="HydrogenBonds" bindtap="onRightToggle" wx:if="{{hasHydrogenBonds}}">氢键</view>
              <view class="mini-toggle {{rightShowAxes ? 'on' : ''}}" data-layer="Axes" bindtap="onRightToggle">轴</view>
              <view class="mini-toggle {{rightShowInterstices ? 'on' : ''}}" data-layer="Interstices" bindtap="onRightToggle" wx:if="{{false}}">空隙</view>
              <view class="mini-toggle {{rightShowOctahedral ? 'on' : ''}}" data-layer="Octahedral" bindtap="onRightToggle" wx:if="{{showIntersticeControl}}">八面体空隙</view>
              <view class="mini-toggle {{rightShowTetrahedral ? 'on' : ''}}" data-layer="Tetrahedral" bindtap="onRightToggle" wx:if="{{showIntersticeControl}}">四面体空隙</view>
              <view class="mini-toggle {{rightShowAuxiliaryBody ? 'on' : ''}}" data-layer="AuxiliaryBody" bindtap="onRightToggle">体对角</view>
              <view class="mini-toggle {{rightShowAuxiliaryFace ? 'on' : ''}}" data-layer="AuxiliaryFace" bindtap="onRightToggle">面对角</view>
              <view class="mini-toggle {{rightShowLatticePoints ? 'on' : ''}}" data-layer="LatticePoints" bindtap="onRightToggle">点阵型式</view>
            </view>
          </view>

          <!-- 晶胞模式：暂时隐藏 -->
          <view class="setting-section" wx:if="{{false}}">
            <text class="setting-section-title">晶胞</text>
            <view class="mini-selector">
              <view class="mini-option {{rightCellDisplayMode === 'conventional' ? 'active' : ''}}" data-mode="conventional" bindtap="onRightCellDisplayModeTap">惯用</view>
              <view class="mini-option {{rightCellDisplayMode === 'primitive' ? 'active' : ''}}" data-mode="primitive" bindtap="onRightCellDisplayModeTap">素胞</view>
            </view>
          </view>

        </view>
      </view>
    </scroll-view>
  </view>
</view>
