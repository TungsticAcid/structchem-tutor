/** 晶体结构对比页面样式 */

.compare-page {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: #eeeeee;
  display: flex;
  flex-direction: column;
}

/* ========== 顶部标题栏 ========== */
.top-bar {
  display: flex;
  align-items: center;
  padding: 60rpx 24rpx 16rpx;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
  z-index: 20;
  flex-shrink: 0;
}
.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.back-icon {
  color: #fff;
  font-size: 36rpx;
}
.crystal-title {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  flex: 1;
}

/* ========== 双画布容器 ========== */
.dual-canvas-container {
  flex: 1;
  display: flex;
  position: relative;
  min-height: 0;
}

/* 横屏布局 */
.layout-horizontal {
  flex-direction: row;
}
.layout-horizontal .canvas-pane {
  flex: 1;
}

/* 竖屏布局 */
.layout-vertical {
  flex-direction: column;
}
.layout-vertical .canvas-pane {
  flex: 1;
}

.canvas-pane {
  position: relative;
  overflow: hidden;
}

/* 分隔线 */
.canvas-divider {
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.2);
}
.divider-horizontal {
  width: 2rpx;
}
.divider-vertical {
  height: 2rpx;
}

/* ========== 画布标签 ========== */
.pane-label {
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  pointer-events: none;
}
.label-text {
  color: rgba(255, 255, 255, 0.5);
  font-size: 22rpx;
  background: rgba(0, 0, 0, 0.4);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

/* ========== 底部浮动控制条 ========== */
.compare-control-bar {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(20, 20, 40, 0.94);
  border-radius: 40rpx;
  padding: 8rpx 20rpx;
  z-index: 25;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.sync-group {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.control-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 12rpx;
  border-radius: 18rpx;
  transition: background 0.2s;
}
.control-btn.active {
  background: rgba(66, 133, 244, 0.3);
}
.control-icon {
  font-size: 28rpx;
  color: #fff;
}
.control-text {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 2rpx;
  white-space: nowrap;
}

.settings-toggle-btn {
  border-left: 1rpx solid rgba(255, 255, 255, 0.15);
  padding-left: 16rpx;
  margin-left: 4rpx;
  border-radius: 18rpx;
}

/* ========== 可展开设置面板 ========== */
.settings-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 0;
  overflow: hidden;
  background: rgba(18, 18, 35, 0.97);
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  z-index: 22;
  transition: max-height 0.3s ease;
}
.settings-panel.expanded {
  max-height: 55vh;
}

.settings-scroll {
  height: 55vh;
}

/* 共享设置行（投影模式） */
.shared-projection-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 10rpx 32rpx 6rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}
.shared-setting-label {
  color: rgba(255, 255, 255, 0.5);
  font-size: 22rpx;
  white-space: nowrap;
}
.shared-selector {
  width: 200rpx;
}

.settings-columns {
  display: flex;
  padding: 8rpx 0 80rpx;
}

.settings-column {
  flex: 1;
  padding: 8rpx 16rpx;
}

.settings-col-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.1);
  flex-shrink: 0;
  margin: 8rpx 0;
}

.settings-col-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 8rpx 0 6rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  margin-bottom: 8rpx;
}
.col-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}
.col-title {
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
}

/* 设置区块 */
.setting-section {
  margin-bottom: 10rpx;
}
.setting-section-title {
  color: rgba(255, 255, 255, 0.45);
  font-size: 20rpx;
  display: block;
  margin-bottom: 4rpx;
}

/* 微型选择器 */
.mini-selector {
  display: flex;
  gap: 6rpx;
}
.mini-option {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.05);
  border-radius: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}
.mini-option.active {
  color: #fff;
  background: rgba(66, 133, 244, 0.3);
  border-color: rgba(66, 133, 244, 0.4);
}

/* 微型开关组 */
.mini-toggles {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.mini-toggle {
  padding: 6rpx 10rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.05);
  border-radius: 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}
.mini-toggle.on {
  color: #fff;
  background: rgba(66, 133, 244, 0.3);
  border-color: rgba(66, 133, 244, 0.4);
}

/* slider 容器微调 */
.setting-section slider {
  width: 100%;
}
