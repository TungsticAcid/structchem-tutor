/** 晶体列表首页样式 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* 设置入口 */
.settings-entry {
  position: fixed;
  top: 110rpx;
  left: 24rpx;
  z-index: 200;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.12);
}

.settings-icon {
  font-size: 36rpx;
}

/* 分类标签栏 */
.category-bar {
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #f0f0f0;
  transition: all 0.2s;
}
.category-item.active {
  color: #fff;
  background: #4285F4;
}

/* 卡片网格 */
.crystal-list {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 24rpx;
  box-sizing: border-box;
}
.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  overflow: hidden;
}
.card-grid > crystal-card {
  width: calc(50% - 12rpx);
  margin-bottom: 24rpx;
}

.list-empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding-top: 200rpx;
}
