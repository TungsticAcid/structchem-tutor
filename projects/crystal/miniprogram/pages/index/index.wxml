<!-- 晶体列表首页 -->
<navigation-bar title="晶体结构库" back="{{false}}" color="black" background="#FFF"></navigation-bar>

<!-- 设置按钮 -->
<view class="settings-entry" bindtap="onSettingsTap">
  <text class="settings-icon">⚙</text>
</view>

<!-- 分类标签 -->
<scroll-view class="category-bar" scroll-x>
  <view class="category-item {{activeCategory === item.key ? 'active' : ''}}"
    wx:for="{{categories}}" wx:key="key"
    data-key="{{item.key}}"
    bindtap="onCategoryTap">
    {{item.name}}
  </view>
</scroll-view>

<!-- 晶体卡片网格 -->
<scroll-view class="crystal-list" scroll-y>
  <view class="card-grid">
    <crystal-card
      wx:for="{{filteredCrystals}}" wx:key="id"
      crystal="{{item}}"
      bind:select="onCrystalTap"
    />
  </view>
  <view class="list-empty" wx:if="{{filteredCrystals.length === 0}}">
    暂无该分类的晶体数据
  </view>
</scroll-view>
