/** 晶体卡片组件样式 */
.crystal-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.15s;
}
.crystal-card:active {
  transform: scale(0.97);
}

/* 缩略图区 */
.card-thumb {
  width: 100%;
  height: 200rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.thumb-canvas {
  width: 100%;
  height: 100%;
}
.thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}
.thumb-icon {
  font-size: 64rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 信息区 */
.card-body {
  padding: 20rpx 24rpx 8rpx;
  box-sizing: border-box;
}
.card-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-formula {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}

/* 晶系标签 */
.card-tag {
  margin: 0 24rpx 16rpx;
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: #4285F4;
  background: rgba(66, 133, 244, 0.1);
  border-radius: 8rpx;
}
