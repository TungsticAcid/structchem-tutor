/** 原子信息弹窗样式 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
  transition: background 0.3s;
}
.popup-mask.animate {
  background: rgba(0, 0, 0, 0.5);
}

.popup-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx 48rpx;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}
.popup-content.slide-up {
  transform: translateY(0);
}

.popup-handle {
  width: 60rpx;
  height: 6rpx;
  background: #ddd;
  border-radius: 3rpx;
  margin: 0 auto 24rpx;
}

/* 元素符号 */
.element-symbol {
  display: block;
  text-align: center;
  font-size: 80rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

/* 空隙类型文字 */
.void-type-text {
  display: block;
  text-align: center;
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* 信息网格 */
.info-grid {
  display: flex;
  flex-wrap: wrap;
}
.info-item {
  width: 50%;
  padding: 16rpx 0;
}
.info-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}
.info-value {
  display: block;
  font-size: 28rpx;
  color: #333;
}

.no-data-text {
  display: block;
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 60rpx 0;
}

/* 关闭按钮 */
.close-btn {
  text-align: center;
  margin-top: 24rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}
.close-text {
  color: #666;
  font-size: 28rpx;
}
