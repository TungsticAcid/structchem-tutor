<!-- 原子/空隙信息弹窗 -->
<view class="popup-mask {{show ? 'show-mask' : ''}} {{animate ? 'animate' : ''}}" wx:if="{{show}}" bindtap="onClose">
  <view class="popup-content {{animate ? 'slide-up' : ''}}" catchtap="onStopPropagation">
    <view class="popup-handle"></view>

    <!-- 空隙信息 -->
    <block wx:if="{{atomData && atomData.isVoid}}">
      <text class="void-type-text">{{atomData.voidName || atomData.voidType || '--'}}</text>
      <view class="info-grid">
        <view class="info-item" wx:if="{{atomData.voidType}}">
          <text class="info-label">空隙类型</text>
          <text class="info-value">{{atomData.voidType === 'octahedral' ? '八面体空隙' : '四面体空隙'}}</text>
        </view>
        <view class="info-item" wx:if="{{atomData.position}}">
          <text class="info-label">分数坐标</text>
          <text class="info-value">{{atomData.position}}</text>
        </view>
      </view>
    </block>

    <!-- 点阵点信息 -->
    <block wx:elif="{{atomData && atomData.isLatticePoint}}">
      <text class="void-type-text">点阵点</text>
      <view class="info-grid">
        <view class="info-item" wx:if="{{atomData.latticeTypeName}}">
          <text class="info-label">点阵型式</text>
          <text class="info-value">{{atomData.latticeTypeName}}</text>
        </view>
        <view class="info-item" wx:if="{{atomData.position}}">
          <text class="info-label">分数坐标</text>
          <text class="info-value">{{atomData.position}}</text>
        </view>
      </view>
    </block>

    <!-- 原子信息 -->
    <block wx:elif="{{atomData}}">
      <!-- 元素符号（大字） -->
      <text class="element-symbol" style="color: {{atomData.color || '#fff'}}">
        {{atomData.element || '--'}}
      </text>

      <!-- 详细信息 -->
      <view class="info-grid">
        <view class="info-item" wx:if="{{atomData.name}}">
          <text class="info-label">元素名称</text>
          <text class="info-value">{{atomData.name}}</text>
        </view>
        <view class="info-item" wx:if="{{atomData.enName}}">
          <text class="info-label">英文名称</text>
          <text class="info-value">{{atomData.enName}}</text>
        </view>
        <view class="info-item" wx:if="{{atomData.atomicNumber}}">
          <text class="info-label">原子序数</text>
          <text class="info-value">{{atomData.atomicNumber}}</text>
        </view>
        <view class="info-item" wx:if="{{atomData.atomicMass}}">
          <text class="info-label">相对原子质量</text>
          <text class="info-value">{{atomData.atomicMass}}</text>
        </view>
        <view class="info-item" wx:if="{{atomData.electronConfig}}">
          <text class="info-label">电子排布</text>
          <text class="info-value">{{atomData.electronConfig}}</text>
        </view>
        <view class="info-item" wx:if="{{atomData.electronegativity}}">
          <text class="info-label">电负性</text>
          <text class="info-value">{{atomData.electronegativity}}</text>
        </view>
        <view class="info-item" wx:if="{{atomData.position}}">
          <text class="info-label">分数坐标</text>
          <text class="info-value">{{atomData.position}}</text>
        </view>
        <view class="info-item" wx:if="{{atomData.radius}}">
          <text class="info-label">原子半径</text>
          <text class="info-value">{{atomData.radius}} Å</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <text class="no-data-text">未选中任何原子</text>
    </block>

    <!-- 关闭按钮 -->
    <view class="close-btn" bindtap="onClose">
      <text class="close-text">关闭</text>
    </view>
  </view>
</view>
