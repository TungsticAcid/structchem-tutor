/* 晶体详情卡片样式 */
.cdc-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  padding: 28rpx;
}

/* 标题区 */
.cdc-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.cdc-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.cdc-formula {
  font-size: 26rpx;
  font-weight: 400;
  color: #888;
}

.cdc-badges {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.cdc-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.badge-system {
  background: #e8f4fd;
  color: #3b82f6;
}

.badge-category {
  background: #fef3c7;
  color: #b45309;
}

.cdc-subtitle {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

/* 对比横幅 */
.cdc-compare-banner {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  background: linear-gradient(135deg, #ede9fe, #fae8ff);
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #7c3aed;
}

.cdc-compare-icon {
  margin-right: 8rpx;
}

/* 分区 */
.cdc-section {
  margin-top: 24rpx;
}

.cdc-section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #999;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.cdc-section-body {
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
}

/* 特征列表 */
.cdc-features {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cdc-feature-item {
  font-size: 28rpx;
  color: #444;
  padding: 8rpx 16rpx;
  background: #f8f9fc;
  border-radius: 8rpx;
  line-height: 1.5;
}

/* 标签 */
.cdc-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.cdc-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.tag-void {
  background: #dbeafe;
  color: #1d4ed8;
}

.tag-ability {
  background: #f0fdf4;
  color: #15803d;
}

/* 操作按钮 */
.cdc-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.cdc-btn {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.15s;
}

.cdc-btn-primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}

.cdc-btn-secondary {
  background: #f0f2f5;
  color: #555;
}

.cdc-btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 差异列表 */
.cdc-diff-item {
  font-size: 26rpx;
  color: #666;
  padding: 6rpx 0;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.cdc-diff-bullet {
  color: #f59e0b;
  font-weight: 700;
}
