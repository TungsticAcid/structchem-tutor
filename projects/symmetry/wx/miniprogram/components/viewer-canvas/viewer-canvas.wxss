.canvas-3d {
  width: 100%;
  height: 100%;
  display: block;
}
.loading-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.25);
}
.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.4);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.loading-text {
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 26rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
