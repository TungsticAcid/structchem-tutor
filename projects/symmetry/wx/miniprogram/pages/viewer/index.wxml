<view class="page">
  <!-- ===== 顶部工具条 ===== -->
  <view class="toolbar">
    <view class="brand">对称视界</view>
    <picker mode="selector" range="{{moleculeNames}}" value="{{moleculeIndex}}" bindchange="onPickerChange">
      <view class="mol-picker">{{moleculeNames[moleculeIndex]}}</view>
    </picker>
    <view class="tool-btn {{sidebarCollapsed ? '' : 'on'}}" bindtap="onSidebarCollapse">☰</view>
    <view class="gear" bindtap="onSettingsOpen">⚙</view>
  </view>

  <!-- ===== 主区：左信息栏 + 拖柄 + 右画布 ===== -->
  <view class="main">
    <!-- 左侧信息栏（可拖宽、可收起；不覆盖画布） -->
    <view class="sidebar" style="width:{{sidebarCollapsed ? 0 : sidebarWidthPx}}px">
      <scroll-view scroll-y class="sidebar-scroll">
        <!-- 显隐开关条 -->
        <view class="toggle-strip">
          <view class="tg"><text>{{str.symSection}}</text><switch checked="{{showSymmetry}}" data-key="showSymmetry" bindchange="onToggle" /></view>
          <view class="tg"><text>{{str.labels}}</text><switch checked="{{showLabels}}" data-key="showLabels" bindchange="onToggle" /></view>
          <view class="tg"><text>{{str.aux}}</text><switch checked="{{showAux}}" data-key="showAux" bindchange="onToggle" /></view>
          <view class="tg"><text>{{str.atomLabel}}</text><switch checked="{{showAtomLabels}}" data-key="showAtomLabels" bindchange="onToggle" /></view>
        </view>

        <!-- ===== 分子库（molecules） ===== -->
        <block wx:if="{{tab==='molecules'}}">
          <view class="sec-title">{{str.molecTitle}}</view>
          <view class="lib-item" wx:for="{{library}}" wx:key="id" data-id="{{item.id}}" bindtap="onLibraryTap">
            <text class="lib-sym">{{item.sym}}</text>
            <text class="lib-name">{{item.name}}</text>
          </view>
        </block>

        <!-- ===== 分子信息（more） ===== -->
        <block wx:elif="{{tab==='more'}}">
          <view class="pt-title">{{panel.title}}</view>
          <view class="pt-formula">{{panel.formula}}</view>
          <view class="group-row">
            <rich-text nodes="{{panel.groupSymbolHtml}}" class="group-symbol"></rich-text>
            <text class="group-name">{{panel.groupName}}</text>
          </view>
          <view class="info-line"><text class="orb-label">化学式</text><text>{{panel.formula}}</text></view>
          <view class="info-line"><text class="orb-label">点群</text><rich-text nodes="{{panel.groupSymbolHtml}}"></rich-text></view>
          <view class="info-line"><text class="orb-label">对称元素</text><text>{{panel.totalElements}} 个 / {{panel.classCount}} 类</text></view>
        </block>

        <!-- ===== 信息面板（elements/operations/pointgroup） ===== -->
        <block wx:else>
          <view class="pt-title">{{panel.title}}</view>
          <view class="pt-formula">{{panel.formula}}</view>
          <view class="group-row">
            <rich-text nodes="{{panel.groupSymbolHtml}}" class="group-symbol"></rich-text>
            <text class="group-name">{{panel.groupName}}</text>
          </view>

          <view class="sec-title">{{str.symSection}}</view>
          <view class="elem-row" wx:for="{{panel.identity}}" wx:key="label">
            <view class="dot" style="background:{{item.color}}"></view>
            <text class="elem-label">{{item.label}}</text>
          </view>
          <block wx:for="{{panel.groups}}" wx:for-item="g" wx:for-index="gi" wx:key="name">
            <view class="elem-head" data-index="{{gi}}" bindtap="onGroupHeader">
              <view class="dot" style="background:{{g.color}}"></view>
              <text class="gname">{{g.name}}</text>
              <text class="gcount">×{{g.count}}</text>
              <text class="arrow">{{g.open ? '▾' : '▸'}}</text>
            </view>
            <view class="elem-body" wx:if="{{g.open}}">
              <view class="elem-row" wx:for="{{g.items}}" wx:for-item="it" wx:key="index">
                <checkbox checked="{{it.checked}}" data-index="{{it.index}}" bindchange="onElementCheck" class="cb" />
                <text class="elem-label">{{it.label}}</text>
                <view class="play" data-index="{{it.index}}" catchtap="onElementPlay">▶</view>
              </view>
            </view>
          </block>

          <view class="ct-header" bindtap="onCtHeader">
            <text>{{str.ctTitle}}</text>
            <text class="arrow">{{ctOpen ? '▾' : '▸'}}</text>
          </view>
          <view class="ct" wx:if="{{ctOpen && panel.characterTable.has}}">
            <view class="ct-row ct-th">
              <view class="ct-cell" wx:for="{{panel.characterTable.header}}" wx:for-item="h">
                <rich-text nodes="{{h.html}}"></rich-text>
              </view>
            </view>
            <view class="ct-row" wx:for="{{panel.characterTable.rows}}" wx:for-item="row">
              <view class="ct-cell ct-irrep"><rich-text nodes="{{row.labelHtml}}"></rich-text></view>
              <view class="ct-cell" wx:for="{{row.chars}}" wx:for-item="ch">{{ch}}</view>
              <view class="ct-cell ct-basis">{{row.linear}}</view>
              <view class="ct-cell ct-basis">{{row.quadratic}}</view>
            </view>
          </view>

          <view class="orbit-block" wx:if="{{orbit.visible}}">
            <view class="orb-line"><text class="orb-label">{{str.orbit}}</text><text class="orb-val">{{orbit.orbLabels}}</text></view>
            <view class="orb-line"><text class="orb-label">{{str.stabilizer}}</text><text class="orb-val">{{orbit.stabNames}}（{{str.order}} {{orbit.order}}）</text></view>
          </view>
        </block>
      </scroll-view>
    </view>

    <!-- 拖柄：拖拽调整侧栏宽度 -->
    <view class="sidebar-handle"
      bindtouchstart="onSidebarDragStart" bindtouchmove="onSidebarDragMove" bindtouchend="onSidebarDragEnd">
      <view class="handle-grip"></view>
    </view>

    <!-- 右侧 3D 画布（绝对定位填满画布区，不覆盖侧栏） -->
    <view class="canvas-area">
      <viewer-canvas
        id="viewer"
        canvasId="moleculeCanvas"
        structure="{{structure}}"
        symmetryElements="{{symmetryElements}}"
        atomScale="{{setAtomScale}}"
        symmetryScale="{{setSymScale}}"
        labelFontSize="{{setLabelFont}}"
        showSymmetry="{{showSymmetry}}"
        showLabels="{{showLabels}}"
        showAux="{{showAux}}"
        showAtomLabels="{{showAtomLabels}}"
        bind:atomTap="onAtomTap"
      />
      <view class="anim-bar panel" wx:if="{{anim.visible}}">
        <view class="anim-btn" bindtap="onAnimInverse">⏮</view>
        <view class="anim-btn" bindtap="onAnimToggle">{{anim.toggleChar}}</view>
        <view class="anim-btn" bindtap="onAnimAgain">⏭</view>
        <slider class="anim-slider" min="0" max="100" value="{{anim.progress}}" block-size="14" activeColor="#7c9cf5" />
        <view class="anim-btn" bindtap="onAnimReset">⟲</view>
        <view class="anim-btn" bindtap="onAnimClose">✕</view>
      </view>
    </view>
  </view>

  <!-- ===== 底部五页签 ===== -->
  <view class="tabbar">
    <view class="tab-item {{tab===item.key ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-tab="{{item.key}}" bindtap="onTabTap">{{item.label}}</view>
  </view>

  <!-- ===== 设置浮层（底部抽屉） ===== -->
  <view class="settings-mask" wx:if="{{settingsOpen}}" bindtap="onSettingsClose">
    <view class="settings panel" catchtap="noop">
      <view class="settings-head"><text>{{str.setTitle}}</text><text class="orb-close" bindtap="onSettingsClose">✕</text></view>
      <scroll-view scroll-y class="settings-body">
        <view class="s-row"><text>{{str.setLang}}</text>
          <picker mode="selector" range="{{['简体中文','English']}}" bindchange="onLangChange">
            <view class="s-value">{{lang==='en' ? 'English' : '简体中文'}}</view>
          </picker>
        </view>
        <view class="s-row"><text>{{str.setBg}}</text>
          <view class="color-chip" data-kind="bg" data-hex="{{setBg}}" bindtap="onColorRowTap"><view class="chip" style="background:{{setBg}}"></view><text class="chip-hex">{{setBg}}</text></view>
        </view>
        <view class="s-row"><text>{{str.setAtomScale}} {{setAtomScaleVal}}</text><slider min="0.5" max="2" step="0.1" value="{{setAtomScale}}" bindchange="onSetAtomScale" /></view>
        <view class="s-row"><text>{{str.setStick}} {{setStickRadiusVal}}</text><slider min="0.03" max="0.3" step="0.01" value="{{setStickRadius}}" bindchange="onSetStickRadius" /></view>
        <view class="s-row"><text>{{str.setSymScale}} {{setSymScaleVal}}</text><slider min="0.5" max="2" step="0.1" value="{{setSymScale}}" bindchange="onSetSymScale" /></view>
        <view class="s-row"><text>{{str.setLabelFont}} {{setLabelFontVal}}</text><slider min="20" max="72" step="2" value="{{setLabelFont}}" bindchange="onSetLabelFont" /></view>
        <view class="s-row"><text>{{str.animSpeed}} {{setAnimSpeedVal}}</text><slider min="10" max="240" step="10" value="{{setAnimSpeed}}" bindchange="onSetAnimSpeed" /></view>
        <view class="s-row"><text>{{str.animDur}} {{setAnimDurationVal}}</text><slider min="500" max="10000" step="500" value="{{setAnimDuration}}" bindchange="onSetAnimDuration" /></view>

        <view class="s-row"><text>{{str.labels}}</text><switch checked="{{showLabels}}" data-key="showLabels" bindchange="onToggle" /></view>
        <view class="s-row"><text>{{str.aux}}</text><switch checked="{{showAux}}" data-key="showAux" bindchange="onToggle" /></view>
        <view class="s-row"><text>{{str.atomLabel}}</text><switch checked="{{showAtomLabels}}" data-key="showAtomLabels" bindchange="onToggle" /></view>

        <view class="sec-title">{{str.elemColorSec}}</view>
        <view class="color-row" wx:for="{{elementColors}}" wx:key="element"
          data-kind="element" data-element="{{item.element}}" data-hex="{{item.color}}" bindtap="onColorRowTap">
          <text class="color-label">{{item.element}}</text>
          <view class="color-chip"><view class="chip" style="background:{{item.color}}"></view><text class="chip-hex">{{item.color}}</text></view>
        </view>

        <view class="sec-title">{{str.symColorSec}}</view>
        <view class="color-row" wx:for="{{symColors}}" wx:key="type"
          data-kind="sym" data-key="{{item.key}}" data-hex="{{item.color}}" bindtap="onColorRowTap">
          <text class="color-label">{{item.label}}</text>
          <view class="color-chip"><view class="chip" style="background:{{item.color}}"></view><text class="chip-hex">{{item.color}}</text></view>
        </view>

        <button class="danger" bindtap="onResetSettings">{{str.setReset}}</button>
      </scroll-view>
    </view>
  </view>

  <!-- ===== 颜色选择弹窗（覆盖画布） ===== -->
  <view class="color-mask" wx:if="{{colorPopup.open}}" bindtap="onColorPopupClose">
    <view class="color-pop panel" catchtap="noop">
      <view class="settings-head"><text>颜色</text><text class="orb-close" bindtap="onColorPopupClose">✕</text></view>
      <view class="cp-preview" style="background:{{colorPopup.hex}}"></view>
      <view class="cp-input-row">
        <text class="cp-hash">#</text>
        <input class="cp-input" value="{{colorPopup.hex}}" bindinput="onColorHexInput" placeholder="#RRGGBB" maxlength="7" />
      </view>
      <view class="cp-grid">
        <view wx:for="{{palette}}" wx:for-item="c" wx:key="*this"
          class="cp-swatch {{colorPopup.hex === c ? 'on' : ''}}" style="background:{{c}}"
          data-color="{{c}}" bindtap="onColorPick" />
      </view>
      <button class="cp-done" bindtap="onColorPopupClose">确定</button>
    </view>
  </view>
</view>
